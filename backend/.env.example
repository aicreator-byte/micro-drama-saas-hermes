# Micro Drama SaaS - Environment Configuration Example
# Copy this file to .env and fill in your values

# App Settings
APP_NAME="Micro Drama SaaS"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL)
# For local development with docker-compose:
DATABASE_URL="postgresql+asyncpg://drama_user:drama_pass@localhost:5432/micro_drama_saas"
# For production:
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security
# IMPORTANT: Generate a strong secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# CORS
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# File Storage
UPLOAD_DIR="/home/hatch/workspace/micro-drama-saas/hermes/uploads"
MAX_UPLOAD_SIZE=104857600  # 100MB

# Google Account Limits
MAX_GOOGLE_ACCOUNTS_PER_USER=20

# AI Provider (for LLM integration)
# Options: nvidia, openai, anthropic, etc.
AI_PROVIDER="nvidia"
AI_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
AI_API_KEY=""
# Nvidia NIM key — read by ai_client via os.getenv (also the fallback
# when a provider has no key configured in Settings). NEVER commit a
# real key: keep it in .env only (git-ignored).
NVIDIA_API_KEY=""
# Google OAuth redirect URI — must match the frontend callback page and
# the URI registered in Google Cloud Console (if OAuth is used).
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/dashboard/google-accounts/callback"

# Billing test webhook (HMAC) — WAJIB di-set untuk secret yang stabil
# antar restart; bila kosong, server memakai secret acak per proses.
# Generate: openssl rand -hex 32. Jangan pakai nilai contoh di bawah ini.
BILLING_TEST_WEBHOOK_SECRET="ganti-dengan-secret-acak-anda"